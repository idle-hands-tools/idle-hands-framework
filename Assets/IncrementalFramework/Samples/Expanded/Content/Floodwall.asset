  m_EditorClassIdentifier: IncrementalFramework.Unity.Expanded::IncrementalFramework.Unity.Expanded.StoryAsset
  Data: '{"Id":"floodwall-v1","Title":"Letters from the Floodwall","Start":"appointment","Variables":[{"Id":"preparedness","Kind":1,"Initial":{"Boolean":false,"Integer":0,"Members":[]},"SurvivesLoop":false},{"Id":"trust","Kind":1,"Initial":{"Boolean":false,"Integer":1,"Members":[]},"SurvivesLoop":false},{"Id":"mayor","Kind":1,"Initial":{"Boolean":false,"Integer":0,"Members":[]},"SurvivesLoop":false},{"Id":"engineer","Kind":1,"Initial":{"Boolean":false,"Integer":0,"Members":[]},"SurvivesLoop":false},{"Id":"ferryman","Kind":1,"Initial":{"Boolean":false,"Integer":0,"Members":[]},"SurvivesLoop":false},{"Id":"doctor","Kind":1,"Initial":{"Boolean":false,"Integer":0,"Members":[]},"SurvivesLoop":false},{"Id":"journalist","Kind":1,"Initial":{"Boolean":false,"Integer":0,"Members":[]},"SurvivesLoop":false},{"Id":"facts","Kind":2,"Initial":{"Boolean":false,"Integer":0,"Members":[]},"SurvivesLoop":false},{"Id":"promises","Kind":2,"Initial":{"Boolean":false,"Integer":0,"Members":[]},"SurvivesLoop":false},{"Id":"kept","Kind":2,"Initial":{"Boolean":false,"Integer":0,"Members":[]},"SurvivesLoop":false},{"Id":"published","Kind":0,"Initial":{"Boolean":false,"Integer":0,"Members":[]},"SurvivesLoop":false}],"Nodes":[{"Id":"appointment","Kind":0,"Chapter":1,"Speaker":"mayor","SubjectKey":"appointment.subject","TextKey":"appointment.body","Next":"ledger","Checkpoint":true,"Variants":[],"Choices":[],"Branches":[],"Effects":[],"Journal":[]},{"Id":"ledger","Kind":0,"Chapter":1,"Speaker":"engineer","SubjectKey":"ledger.subject","TextKey":"ledger.body","Next":"first-warning","Checkpoint":false,"Variants":[],"Choices":[],"Branches":[],"Effects":[],"Journal":["gauge","ledger"]},{"Id":"first-warning","Kind":1,"Chapter":1,"Speaker":"journalist","SubjectKey":"first-warning.subject","TextKey":"first-warning.body","Next":null,"Checkpoint":false,"Variants":[],"Choices":[{"Id":"publish","TextKey":"publish.text","Target":"whistleblower","Requirement":{"Kind":0,"Variable":null,"Boolean":true,"Integer":0,